# CS587 Phase 1 - Electric Appliances E-Commerce Platform
# Environment Configuration File
# 
# IMPORTANT: Never commit this file to Git!
# Add .env to your .gitignore file
#
# Copy this file and replace the placeholder values with your actual keys

# ============================================
# OpenAI API Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY= set your api key

# ============================================
# Model Configuration
# ============================================
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Recommendation: Use gpt-4 for best results, gpt-3.5-turbo for testing/cost savings
MODEL_NAME=gpt-4

# Temperature: Controls randomness (0.0 = focused, 1.0 = creative)
# Recommended: 0.7 for balanced output, 0.3 for more focused, 0.9 for more creative
TEMPERATURE=0.7

# Max tokens per response
MAX_TOKENS=2000

# ============================================
# Project Information
# ============================================
PROJECT_NAME=Electric Appliances E-Commerce Platform
PROJECT_DOMAIN=Retail - Electronic Appliances
TEAM_NUMBER=17
# ============================================
# Phase Configuration
# ============================================
PHASE=Phase_1_Waterfall
METHODOLOGY=Waterfall

# ============================================
# Optional: Alternative LLM Configuration
# ============================================
# If using Azure OpenAI, uncomment and configure:
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=your-azure-endpoint
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# ============================================
# Execution Settings
# ============================================
# For AutoGen
MAX_TURNS=2
MAX_ROUNDS=15

# For logging
LOG_LEVEL=INFO
SAVE_OUTPUTS=true
OUTPUT_DIR=outputs

# ============================================
# SETUP INSTRUCTIONS:
# ============================================
# 1. Copy this file to create your own .env:
#    cp .env.example .env
#
# 2. Add your OpenAI API key above
#
# 3. (Optional) Adjust model and temperature settings
#
# 4. Never commit .env to version control!
#
# 5. Verify setup by running:
#    python api_keys_config.py
#
# ============================================
